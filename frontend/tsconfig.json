{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@tarojs/taro", "@types/react", "@types/react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "config/**/*.ts"]
}
